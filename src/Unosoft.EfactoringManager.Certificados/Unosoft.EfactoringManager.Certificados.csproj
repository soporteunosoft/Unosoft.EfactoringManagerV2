<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Cuando todo compile, puedes cambiar a net9.0 -->
    <OutputType>Library</OutputType>
    <RootNamespace>Unosoft.EfactoringManager.Certificados</RootNamespace>
    <AssemblyName>Unosoft.EfactoringManager.Certificados</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- JSON -->
    <PackageReference Include="Abp.ZeroCore" Version="10.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- WCF CLIENT (los ÚNICOS válidos en net8/net9) -->
    <!-- Configuración clásica -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.1" />
  </ItemGroup>
  <!--
    NO agregues Compile explícito para Reference.cs
    El SDK lo incluye automáticamente
  -->
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="8.*" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="8.*" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.*" />
  </ItemGroup>
</Project>